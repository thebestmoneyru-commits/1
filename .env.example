GEMINI_API_KEY=

# PROMPTGPT v2 is disabled until a strong, private key is configured.
# Generate a random secret (at least 32 characters) and use the same value in the app UI.
PROMPTGPT_V2_ACCESS_KEY=
# Optional: defaults to gemini-3.1-flash-lite (must be enabled for v2 tasks).
PROMPTGPT_V2_MODEL=gemini-3.1-flash-lite


# Optional remote inference. Values must be trusted HTTPS origins, comma-separated.
# Request-provided remoteUrl values are ignored unless their origin appears in the matching allowlist.
SLOPTOTAL_REMOTE_ALLOWED_ORIGINS=
MGT_EVAL_REMOTE_ALLOWED_ORIGINS=
